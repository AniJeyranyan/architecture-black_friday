        <mxCell id="d5_title" value="Variant 5: CDN in several regions + API Gateway + Consul (service discovery) + sharding + replication + caching (Redis)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="1700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d5_note" value="pymongo-api instances register in Consul on start and are removed when they stop or fail the health check. The API Gateway takes the list of healthy instances from Consul and balances requests between them, so instances can be added or removed without downtime." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="350" height="100" as="geometry" />
